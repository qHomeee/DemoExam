<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DemoForMuhin.App" RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window"><Setter Property="FontFamily" Value="Calibri" /></Style>
    </Application.Styles>
</Application>
